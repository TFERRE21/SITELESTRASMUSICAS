# Public site URL used for canonical URLs and sitemap generation.
# Example: https://www.example.com
VITE_PUBLIC_SITE_URL=

# Advertisement integration is disabled until real identifiers are provided.
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_HOME=

# Configure private server-side variables only in the hosting provider's secret store.
# Never prefix a secret with VITE_ (Vite exposes VITE_* values to the browser).
DATABASE_URL=
CONTACT_EMAIL=
COPYRIGHT_CONTACT_EMAIL=

# LRCLIB is public and does not require an API key.
# No LRCLIB_API_KEY, MUSIXMATCH_API_KEY, lyrics toggle, or sync token is required.
# Persistent directory for catalog metadata, accounts, sessions, and support tickets. Ensure this path is on a persistent volume in production.
DATA_DIR=/data


# Required to access the protected support administration API. Set a long random secret in hosting.
ADMIN_SUPPORT_TOKEN=
