# Public site URL used for canonical URLs and sitemap generation.
# Example: https://www.example.com
VITE_PUBLIC_SITE_URL=

# Advertisement integration is disabled until real identifiers are provided.
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_HOME=

# Configure private server-side variables only in the hosting provider's secret store.
# Never prefix a secret with VITE_ (Vite exposes VITE_* values to the browser).
DATABASE_URL=
CONTACT_EMAIL=
COPYRIGHT_CONTACT_EMAIL=

# Private catalog provider credentials (server-side only; never use VITE_ prefix)
MUSIXMATCH_API_KEY=
# Keep false until the contract explicitly permits displaying full lyrics.
MUSIXMATCH_LYRICS_ENABLED=false
# Strong random token used only for authenticated manual catalog sync.
CATALOG_SYNC_TOKEN=
# Mount a persistent VPS volume here to retain the daily catalog cache.
DATA_DIR=/data
